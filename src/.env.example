# Copy to src/.env and choose your own values. src/.env is git-ignored; never commit it.
# SQL Server password policy: at least 8 characters with upper case, lower case, digits and symbols.
# Avoid ; ' and " in passwords (they are passed through connection strings and SQL scripts).

# SQL Server administrator - used only by grate to deploy the database.
MSSQL_SA_PASSWORD=

# Least-privilege login the API connects with (created by src/dbOrder/beforeMigration).
ORDER_DB_USER=svc_order_api
ORDER_DB_PASSWORD=

# Host port for SQL Server (change if 1433 is already used by a local instance;
# then also change ApplicationConfiguration:Persistence:ApplicationDatabase:Server in appsettings.Localhost.json).
SQL_HOST_PORT=1433

# Signing key of the local JWTs, so the API container (profile "api") accepts tokens from
# build/local/New-LocalToken.ps1. Filled in by: ./build/local/New-LocalToken.ps1 -UpdateEnvFile
ORDER_JWT_SIGNING_KEY=
