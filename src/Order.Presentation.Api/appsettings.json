{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ApplicationConfiguration": {
    "Observability": {
      "ApplicationName": "Order.Api",
      "OtlpEndpoint": ""
    },
    "Persistence": {
      "ApplicationDatabase": {
        "Server": "",
        "Database": "dbOrder",
        "Username": "",
        "Password": "",
        "Encrypt": true
      }
    },
    "Outbox": {
      "PollingInterval": "00:00:10",
      "BatchSize": 20,
      "MaxAttempts": 5,
      "LockDuration": "00:05:00"
    },
    "PaymentGateways": {
      "Card": {
        "BaseUrl": "https://api.payment.com/",
        "ApiKey": "",
        "UseMockProvider": false,
        "RetryCount": 3,
        "RetryBackoffBaseSeconds": 2,
        "CircuitBreakerFailureThreshold": 5,
        "CircuitBreakerDuration": "00:00:30",
        "Timeout": "00:00:30"
      },
      "PayPal": {
        "BaseUrl": "https://api.paypal.com/",
        "ApiKey": "",
        "UseMockProvider": false,
        "RetryCount": 3,
        "RetryBackoffBaseSeconds": 2,
        "CircuitBreakerFailureThreshold": 5,
        "CircuitBreakerDuration": "00:00:30",
        "Timeout": "00:00:30"
      }
    },
    "Smtp": {
      "Host": "smtp.gmail.com",
      "Port": 587,
      "EnableSsl": true,
      "FromAddress": "noreply@company.com",
      "Username": "",
      "Password": ""
    },
    "Resilience": {
      "Email": {
        "MaxRetryAttempts": 3,
        "BaseDelay": "00:00:01",
        "Timeout": "00:00:30"
      }
    },
    "RateLimiting": {
      "PermitLimit": 60,
      "Window": "00:01:00"
    },
    "Reconciliation": {
      "PollingInterval": "00:01:00",
      "BatchSize": 20,
      "StalledPaymentTimeout": "00:05:00"
    }
  }
}
