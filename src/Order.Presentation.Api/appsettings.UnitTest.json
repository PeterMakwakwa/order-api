{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning"
    }
  },
  "ApplicationConfiguration": {
    "Observability": {
      "ApplicationName": "Order.Api.Tests"
    },
    "Outbox": {
      "PollingInterval": "00:00:01",
      "BatchSize": 20,
      "MaxAttempts": 3,
      "LockDuration": "00:01:00"
    },
    "PaymentGateways": {
      "Card": {
        "BaseUrl": "https://card.test/",
        "RetryCount": 2,
        "RetryBackoffBaseSeconds": 0,
        "CircuitBreakerFailureThreshold": 5,
        "Timeout": "00:00:10"
      },
      "PayPal": {
        "BaseUrl": "https://paypal.test/",
        "RetryCount": 2,
        "RetryBackoffBaseSeconds": 0,
        "Timeout": "00:00:10"
      }
    },
    "Smtp": {
      "Host": "localhost",
      "FromAddress": "noreply@test.local"
    },
    "Resilience": {
      "Email": {
        "MaxRetryAttempts": 1,
        "BaseDelay": "00:00:00.001",
        "Timeout": "00:00:05"
      }
    },
    "RateLimiting": {
      "PermitLimit": 1000,
      "Window": "00:01:00"
    }
  }
}
