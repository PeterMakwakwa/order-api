# Line endings follow .editorconfig (end_of_line = crlf) on every OS, so `dotnet format --verify-no-changes`
# passes on Linux CI runners as well as on Windows.
* text=auto eol=crlf

# Files read by Linux tools in containers keep LF.
*.sh text eol=lf
.env* text eol=lf
docker-compose*.yml text eol=lf
Dockerfile text eol=lf

# Binary.
*.png binary
*.jpg binary
*.ico binary
